# Secrets / local config
.env

# Local SQLite data (dev only - production uses the docker volume)
data/
*.db
*.db-journal

# Python
__pycache__/
*.pyc
.venv/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Build output copied into the backend's static mount for local dev
app/static/*
!app/static/.gitkeep

# OS / editor cruft
.DS_Store

# Local-only notes never meant to be pushed (see the file itself for why)
*.local.md
