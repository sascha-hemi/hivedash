# --- Nginx Proxy Manager ---
# Base URL of your NPM admin UI (the API lives under the same host).
NPM_URL=https://npm.example.internal:81
# Create a dedicated NPM user for this (Users -> Add User) instead of using
# your own admin login - give it the minimum role NPM allows.
NPM_EMAIL=dashboard@example.internal
NPM_PASSWORD=change-me
# Set to false only if NPM uses a self-signed cert you haven't installed.
NPM_VERIFY_SSL=true

# --- Proxmox VE ---
PROXMOX_URL=https://proxmox.example.internal:8006
# Create via: Datacenter -> Permissions -> API Tokens (uncheck "Privilege
# Separation" only if you understand the tradeoff; otherwise also add an
# explicit permission for the token under Datacenter -> Permissions with the
# read-only "PVEAuditor" role on path "/").
PROXMOX_TOKEN_ID=root@pam!dashboard
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Proxmox ships with a self-signed cert by default -> usually false.
PROXMOX_VERIFY_SSL=false

# --- General ---
# How often each source is polled, independently - NPM's proxy host list/online-flag rarely
# changes (a slow interval is fine), while Proxmox's CPU/RAM/status is what the dashboard should
# feel "live" for. Live updates are pushed to open dashboards over a websocket as soon as a poll
# completes, so a fast PROXMOX_POLL_INTERVAL_SECONDS is what actually makes the UI feel real-time.
NPM_POLL_INTERVAL_SECONDS=60
PROXMOX_POLL_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=10

# --- Database ---
# Put this on the mounted volume (see docker-compose.yml) so it survives container rebuilds.
DATABASE_PATH=data/dashboard.db

# --- Auth / sessions ---
# Random secret used to sign the transient OIDC state/nonce cookie (not the login session itself,
# which is DB-backed). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_SECRET=change-me
# Set to false only for local HTTP testing without TLS.
COOKIE_SECURE=true
SESSION_LIFETIME_DAYS=30
# The externally-reachable base URL of this dashboard - required for OIDC (the redirect_uri sent
# to the provider is "{PUBLIC_BASE_URL}/api/auth/oidc/callback").
PUBLIC_BASE_URL=https://dashboard.example.internal
# Creates this admin account on first startup if no user exists yet. Leave blank to skip (e.g. if
# you're bootstrapping via OIDC instead - the first OIDC login ever becomes admin automatically).
BOOTSTRAP_ADMIN_EMAIL=admin@example.internal
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- OIDC (generic - e.g. Authentik) ---
# Leave all three blank to disable OIDC login (local email/password login always stays available).
OIDC_ISSUER=https://auth.example.internal/application/o/dashboard/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Logo library ---
# Auto-download a matching icon from github.com/homarr-labs/dashboard-icons for any service that
# has no local logo match yet (only happens once per service - never overwrites a manual choice).
# Set to false to keep polling fully offline; you can still search/import manually in /admin/logos.
LOGO_CATALOG_AUTO_IMPORT=true
